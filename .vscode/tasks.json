{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (xc8)",
      "type": "shell",
      "command": "make",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build.ps1"
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "xc8",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build.ps1 -Clean"
      },
      "problemMatcher": []
    }
  ]
}
